{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wyd2",
  "version": "1.0.0",
  "identifier": "com.andy.wyd2",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "wyd2",
        "width": 400,
        "height": 650,
        "visible": false,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "decorations": false
      },
      {
        "label": "stats",
        "title": "Stats",
        "url": "index.html#stats",
        "width": 800,
        "height": 600,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
